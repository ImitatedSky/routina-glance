    <string name="conversation_delete">刪除這個對話</string>
    <string name="conversation_delete_title">刪除這個對話？</string>
    <string name="conversation_delete_message">只會刪掉 Glance 裡存的紀錄，聊天 App 裡的訊息不受影響。</string>
    <string name="conversation_today">今天</string>
    <string name="conversation_yesterday">昨天</string>
