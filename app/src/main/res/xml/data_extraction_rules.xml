<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 起 allowBackup=false 只擋雲端備份，換機時的「裝置對裝置轉移」照樣會搬資料。
  存的是別人傳來的訊息，兩條路都整個排除。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
